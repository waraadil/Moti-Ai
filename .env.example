# ---------------------------------------------------------------------------
# Moti AI environment template
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.local is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> Data API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Safe for the browser: the "anon" / "publishable" key. Row Level Security
# decides what it can actually read.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Server only (never prefixed with NEXT_PUBLIC_) ------------------------
# Project Settings -> API keys -> service_role. This key bypasses Row Level
# Security, so it must only ever be used in server-side code. It is optional for
# the app to boot; provider ingest jobs require it.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" to make /api/health perform a live database round-trip when a
# service role key is present. Off by default.
MOTI_ENABLE_DB_VERIFY="false"
