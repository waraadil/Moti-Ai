# ---------------------------------------------------------------------------
# Moti AI environment template
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.local is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> Data API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Safe for the browser: the "anon" / "publishable" key. Row Level Security
# decides what it can actually read.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Server only (never prefixed with NEXT_PUBLIC_) ------------------------
# Project Settings -> API keys -> service_role. This key bypasses Row Level
# Security, so it must only ever be used in server-side code. It is optional for
# the app to boot; provider ingest jobs require it.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" to make /api/health perform a live database round-trip when a
# service role key is present. Off by default.
MOTI_ENABLE_DB_VERIFY="false"

# --- Analysis engine -------------------------------------------------------
#
# MOTI_ANALYSIS_PROVIDER selects the analyser:
#
#   deterministic   (default) offline rule engine. REAL analysis of your messages,
#                   but NOT a language model. No network, no key, no cost.
#
#   anthropic       Claude via the Messages API.
#   openai          OpenAI Chat Completions.
#   gemini          Google Gemini (OpenAI-compatible endpoint).
#   groq            Groq (fast, generous free tier).
#   mistral         Mistral.
#   deepseek        DeepSeek.
#   together        Together AI.
#   openrouter      OpenRouter (many models behind one key).
#   ollama          LOCAL runtime — needs no key. Requires Ollama running locally.
#   lmstudio        LOCAL runtime — needs no key.
#   openai-compatible   Any other OpenAI-compatible endpoint. Requires
#                       MOTI_ANALYSIS_BASE_URL.
#
MOTI_ANALYSIS_PROVIDER="deterministic"

# One key variable for every vendor. Server-side only.
# NEVER prefix with NEXT_PUBLIC_, and never commit a real key.
#   OpenAI      https://platform.openai.com/api-keys
#   Gemini      https://aistudio.google.com/app/apikey
#   Groq        https://console.groq.com/keys
#   Anthropic   https://console.anthropic.com/settings/keys
MOTI_ANALYSIS_API_KEY=""

# Legacy alias, still honoured when the provider is anthropic.
ANTHROPIC_API_KEY=""

# Model name. Leave blank to use the provider's documented default.
# The verify script prints which model will be used.
MOTI_ANALYSIS_MODEL=""

# Override the endpoint. Always wins over the built-in default, so any
# OpenAI-compatible gateway works (a proxy, an Azure deployment, a self-hosted
# llama.cpp server, etc.).
MOTI_ANALYSIS_BASE_URL=""

# True only for a LOCAL runtime that has no authentication.
# NEVER set this true for a hosted provider.
MOTI_ANALYSIS_ALLOW_NO_KEY="false"

# Per-attempt timeout in milliseconds, and total attempts including the first.
MOTI_ANALYSIS_TIMEOUT_MS="120000"
MOTI_ANALYSIS_MAX_ATTEMPTS="3"

# Used only for attribution headers on providers that ask for them (OpenRouter).
MOTI_ANALYSIS_APP_URL=""
